# ===== dsh-miasaki 根 .gitignore（monorepo 重组 2026-08-22）=====

# ---- 依赖与包管理器缓存 ----
node_modules/
.npm-cache/
.npm-cache-tmp/
.pnpm-store/

# ---- 官方仓库克隆与本地备份（含嵌套 .git，禁止入库）----
vendor/
_refs/

# ---- 发布产物（dsh-miasaki-desktop 构建链路产出）----
dist/

# ---- Rust 构建产物（src-tauri）----
dsh-miasaki-desktop/src-tauri/target/
dsh-miasaki-desktop/src-tauri/gen/
dsh-miasaki-desktop/src-tauri/injected/

# ---- 外部工具数据（非本项目产物，工具可能重建，保留 ignore）----
.freebuff/
_bailian_test/
_mimo_test/

# ---- 外部素材参考（半成品/压缩包，不入库）----
hatch-pet-kurumi-main/
.ref-kurumi.tgz
# 任何本地归档/压缩包一律不入库(防 git add . 误提交几百 MB 包)
*.zip
*.tgz

# ---- IDE / 工具私有状态（不入库、不可再生）----
.vs/
.monkeycode/
.learnings/

# ---- 临时脚本（读取本地凭据 ~/.dsh/.credentials.yaml）----
_api_connectivity_check.mjs

# ---- 诊断截图（desktop 构建链目录下均为验证过程截图）----
dsh-miasaki-desktop/scripts/*.png

# ---- fleet 文件总线 · 运行时产物（可再生的执行痕迹）----
# 含中间 / 的模式锚定到根，故 agents/、state/ 须带 dsh-miasaki-fleet/ 前缀
dsh-miasaki-fleet/agents/*/status.json
dsh-miasaki-fleet/agents/*/transcript.md
dsh-miasaki-fleet/agents/*/usage.jsonl
dsh-miasaki-fleet/agents/*/logs/
dsh-miasaki-fleet/agents/*/sessions/
dsh-miasaki-fleet/agents/*/inbox/
dsh-miasaki-fleet/agents/archive/*/status.json
dsh-miasaki-fleet/agents/archive/*/transcript.md
dsh-miasaki-fleet/agents/archive/*/usage.jsonl
dsh-miasaki-fleet/agents/archive/*/logs/
dsh-miasaki-fleet/agents/archive/*/sessions/
dsh-miasaki-fleet/agents/archive/*/inbox/
dsh-miasaki-fleet/state/fleet-pulse.json

# ---- 测试日志 ----
dsh-miasaki-fleet/tests/m3-acp/logs/

# ---- 日志与系统杂项 ----
*.log
dsh-miasaki-desktop/.edge-test-profile
.workbuddy/
Thumbs.db
Desktop.ini
