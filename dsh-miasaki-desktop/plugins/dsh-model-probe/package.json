{
  "name": "dsh-model-probe",
  "version": "0.2.1",
  "type": "module",
  "description": "模型连通性真实探测：为设置页「测试连通性」提供两段式可用性探测（零消耗握手 + 1-token 生成确认），host 侧同源 JSON 路由。",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./probe": {
      "default": "./lib/probe.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "test": "node test/probe.test.js && node test/settings-read.test.js"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-settings": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
