{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Miasaki",
  "version": "0.1.0",
  "identifier": "com.miasaki.desktop",
  "build": {
    "frontendDist": "../ui",
    "beforeDevCommand": "npm run gen-init",
    "beforeBuildCommand": "npm run gen-init"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Miasaki 专属 DSH 桌面端",
    "longDescription": "Miasaki — 时崎狂三主题的专属 DSH 桌面客户端：三主题（原版/刻刻帝/狂狂帝）、双击即开、自动拉起 DSH 服务。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
