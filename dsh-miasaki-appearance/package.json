{
  "name": "@miasaki/dsh-appearance",
  "version": "0.1.0-miasaki.0",
  "description": "设置里新增一栏「外观」：主题皮肤 / 壁纸 / 动效 / 会话效果，零 shell 改动、关掉即原生。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/",
    "test/",
    "cordis.patch.yml",
    "README.md",
    "scripts/",
    "lib/skins/",
    "assets/"
  ],
  "scripts": {
    "build": "node --check index.js && node --check client.js && node --check lib/config.js && node --check lib/splash.js && node --check lib/avatar.js && node --check lib/icon-presets.js && node --check lib/store.js && node --check lib/fence.js",
    "prepare": "pnpm run build",
    "test": "node --test test/*.test.js",
    "derive": "node scripts/derive-skins.mjs",
    "derive:check": "node scripts/derive-skins.mjs --check"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.2-rc.1 <0.3.0"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": false
    }
  }
}
