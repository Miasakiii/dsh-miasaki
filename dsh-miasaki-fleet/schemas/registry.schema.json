{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "fleet registry",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "name", "invoke", "metering", "bin", "binPath", "version"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
      "name": { "type": "string", "minLength": 1 },
      "invoke": { "type": "string", "minLength": 1 },
      "metering": { "type": "string", "enum": ["json-cost-usd", "console-usage", "session", "unknown"] },
      "bin": { "type": "string", "minLength": 1 },
      "binPath": { "type": "string", "minLength": 1 },
      "version": { "type": "string", "minLength": 1 }
    }
  }
}
