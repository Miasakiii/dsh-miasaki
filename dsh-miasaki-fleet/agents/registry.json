[
  {
    "metering": "console-usage",
    "id": "bl",
    "binPath": "%USERPROFILE%\\AppData\\Roaming\\npm\\bl.ps1",
    "name": "Bailian CLI",
    "bin": "bl",
    "invoke": "bl text chat --message {prompt}",
    "runtime_kind": "bailian",
    "kind": "tool-cli",
    "version": "bl 2.2.1"
  },
  {
    "metering": "json-cost-usd",
    "id": "claude",
    "binPath": "%USERPROFILE%\\.local\\bin\\claude.exe",
    "name": "Claude Code",
    "bin": "claude",
    "invoke": "claude -p {prompt} --output-format json",
    "runtime_kind": "claude-code",
    "kind": "coding-agent",
    "version": "2.1.302 (Claude Code)"
  },
  {
    "metering": "session",
    "id": "dsh",
    "binPath": "%USERPROFILE%\\AppData\\Roaming\\npm\\dsh.ps1",
    "name": "DSH CLI",
    "bin": "dsh",
    "invoke": "dsh --profile headless {prompt}",
    "runtime_kind": "dsh",
    "kind": "coding-agent",
    "version": "0.2.1-rc.2"
  },
  {
    "metering": "unknown",
    "id": "pi",
    "binPath": "%USERPROFILE%\\AppData\\Roaming\\npm\\pi.ps1",
    "name": "pi coding agent",
    "bin": "pi",
    "invoke": "pi -p {prompt}",
    "runtime_kind": "pi",
    "kind": "coding-agent",
    "version": "1.0.4"
  },
  {
    "metering": "unknown",
    "id": "mimo",
    "binPath": "%USERPROFILE%\\AppData\\Roaming\\npm\\mimo.ps1",
    "name": "MiMo Code (mimocode)",
    "bin": "mimo",
    "invoke": "mimo run {prompt}",
    "runtime_kind": "mimocode",
    "kind": "coding-agent",
    "version": "0.1.14"
  },
  {
    "metering": "unknown",
    "id": "agent-browser",
    "binPath": "%USERPROFILE%\\AppData\\Roaming\\npm\\agent-browser.ps1",
    "name": "agent-browser",
    "bin": "agent-browser",
    "invoke": "agent-browser {prompt}",
    "runtime_kind": "agent-browser",
    "kind": "tool-cli",
    "version": "agent-browser 0.34.0"
  }
]
