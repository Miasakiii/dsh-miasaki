{
  "name": "@miasaki/dsh-sidebar",
  "version": "0.4.1-miasaki.1",
  "description": "A lightweight right sidebar plugin for DeepSeek Harness: review checklist + terminal launcher + side chat, built without any heavy sidebar base.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "node --check index.js && node --check client.js",
    "prepare": "pnpm run build",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": false
    }
  }
}
