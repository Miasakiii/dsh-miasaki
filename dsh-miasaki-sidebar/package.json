{
  "name": "@miasaki/dsh-sidebar",
  "version": "0.10.0-miasaki.0",
  "description": "A lightweight DeepSeek Harness web plugin: review checklist on the official right sidebar, plus an embedded multi-tab terminal bottom panel and a system terminal launcher — built without any heavy sidebar base.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "pnpm-workspace.yaml",
    "README.md"
  ],
  "scripts": {
    "build": "node --check index.js && node --check client.js",
    "prepare": "pnpm run build",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": false
    }
  },
  "dependencies": {
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "node-pty": "1.2.0-beta.15",
    "ws": "^8.21.3"
  }
}
