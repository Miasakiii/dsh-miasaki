{
  "name": "@miasaki/dsh-sidebar",
  "version": "0.10.0",
  "description": "官方右栏的「审查」与「辅助对话」两个 tab；外加底部内嵌多标签终端（Ctrl+`）与系统终端启动器。不安装任何重型侧边栏基座，全部自研。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "pnpm-workspace.yaml",
    "README.md"
  ],
  "scripts": {
    "build": "node --check index.js && node --check client.js",
    "prepare": "npm run build",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.2-rc.1 <0.3.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": false
    }
  },
  "dependencies": {
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "node-pty": "1.2.0-beta.15",
    "ws": "^8.21.3"
  }
}
