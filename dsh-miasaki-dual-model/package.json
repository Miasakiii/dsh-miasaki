{
  "name": "@miasaki/dsh-dual-model",
  "version": "0.1.3-miasaki.0",
  "description": "会话级「主模型 + 辅助模型」：任一支持图片即可发图，输入框右下角快速配置。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/",
    "test/",
    "patches/",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "node --check index.js && node --check client.js && node --check lib/content.js && node --check lib/routing.js && node --check lib/capability.js && node --check lib/invalidation.js && node --check lib/store.js && node --check patches/dsh-api-session-controller/patch.mjs",
    "prepare": "pnpm run build",
    "test": "node --test test/*.test.js",
    "patch:verify": "node patches/dsh-api-session-controller/patch.mjs verify",
    "patch:status": "node patches/dsh-api-session-controller/patch.mjs status"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.2-rc.1 <0.3.0"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": false
    }
  }
}
